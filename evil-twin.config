# 360T7 Evil-Twin 安全实验固件 seed（官方 immortalwrt openwrt-25.12）
# 手写精简 seed：只列非默认项，其余由 make defconfig 补全。
# 注意 kconfig 可见性坑：DEPENDS 不带 + 的依赖必须在这里显式 =y。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y

# ---- 无线栈（设备默认会拉，显式防丢；mt76/mac80211） ----
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_wpad-openssl=y

# ---- LuCI + web（ucode 栈） ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_uhttpd-mod-ucode=y
CONFIG_PACKAGE_uhttpd-mod-lua=y

# ---- captive portal / DHCP ----
CONFIG_PACKAGE_lighttpd=y
CONFIG_PACKAGE_kea-dhcp4=y
CONFIG_PACKAGE_php8=y
CONFIG_PACKAGE_php8-cgi=y

# ---- 攻击链（feed 自带） ----
CONFIG_PACKAGE_aircrack-ng=y
CONFIG_PACKAGE_hcxtools=y
CONFIG_PACKAGE_hcxdumptool=y
CONFIG_PACKAGE_reaver=y
CONFIG_PACKAGE_pixiewps=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_tcpdump=y

# ---- zerotier（保留） ----
CONFIG_PACKAGE_zerotier=y

# ---- 运行时依赖（kconfig 可见性坑，须显式） ----
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_getopt=y
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_coreutils-sleep=y

# ---- 对照 24.10 旧固件补回（2026-10-16 差异盘点） ----
CONFIG_PACKAGE_curl=y                      # airgeddon 必需项，默认集没有，必须显式
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_luci-theme-argon=y          # 旧固件惯用主题（25.12 feed 有）
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y      # 中文界面（旧固件同款写法）
# ---- 追加（2026-10-16）：包管理器 UI + LED 控制 ----
CONFIG_PACKAGE_luci-app-package-manager=y
# 360T7 两颗 GPIO LED（status red/gpio3 + green/gpio7）；timer/heartbeat/netdev/
# default-on 触发器为内核内置，LuCI LED 页（luci-mod-system 自带）直接可用
CONFIG_PACKAGE_kmod-leds-gpio=y

# ---- 编译提速（2026-10-16）：ccache + workflow 缓存 staging_dir/toolchain ----
CONFIG_CCACHE=y
