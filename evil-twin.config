# 360T7 Evil-Twin 安全实验固件 seed（官方 immortalwrt openwrt-25.12）
# 手写精简 seed：只列非默认项，其余由 make defconfig 补全。
# 注意 kconfig 可见性坑：DEPENDS 不带 + 的依赖必须在这里显式 =y。
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y

# ---- 无线栈（设备默认会拉，显式防丢；mt76/mac80211） ----
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_mt7981-wo-firmware=y
CONFIG_PACKAGE_wpad-openssl=y

# ---- LuCI + web（ucode 栈） ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_uhttpd-mod-ucode=y
CONFIG_PACKAGE_uhttpd-mod-lua=y

# ---- captive portal / DHCP ----
CONFIG_PACKAGE_dnsmasq-full=y              # evil twin 的 DHCP/DNS 劫持按 full 版验证（PROVIDES dnsmasq，defconfig 自动替换基础版）；旧固件的 full 是 passwall 拉的，这里必须显式
CONFIG_PACKAGE_lighttpd=y
CONFIG_PACKAGE_kea-dhcp4=y
CONFIG_PACKAGE_php8=y
CONFIG_PACKAGE_php8-cgi=y

# ---- 基础运维 ----
CONFIG_PACKAGE_openssh-sftp-server=y       # dropbear 装了它才提供 sftp 子系统（25.12 默认镜像不带）

# ---- 攻击链（feed 自带） ----
CONFIG_PACKAGE_aircrack-ng=y
CONFIG_PACKAGE_hcxtools=y
CONFIG_PACKAGE_hcxdumptool=y
CONFIG_PACKAGE_reaver=y
CONFIG_PACKAGE_pixiewps=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_tcpdump=y

# ---- zerotier（保留） ----
CONFIG_PACKAGE_zerotier=y

# ---- 运行时依赖（kconfig 可见性坑，须显式） ----
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_nftables-json=y             # 25.12 包名更名（原 nftables 符号不存在，=y 被 defconfig 静默剪掉；nft 命令由它提供）
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_getopt=y
CONFIG_PACKAGE_script-utils=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_coreutils-sleep=y

# ---- 对照 24.10 旧固件补回（2026-10-16 差异盘点） ----
CONFIG_PACKAGE_curl=y                      # airgeddon 必需项，默认集没有，必须显式
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_luci-theme-argon=y          # 旧固件惯用主题（25.12 feed 有）
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y      # 中文界面（旧固件同款写法）
# ---- 追加（2026-10-16）：包管理器 UI + LED 控制 ----
CONFIG_PACKAGE_luci-app-package-manager=y
# 360T7 两颗 GPIO LED（status red/gpio3 + green/gpio7）；timer/heartbeat/netdev/
# default-on 触发器为内核内置，LuCI LED 页（luci-mod-system 自带）直接可用
CONFIG_PACKAGE_kmod-leds-gpio=y

# ---- 编译提速（2026-10-16）：ccache + workflow 缓存 staging_dir/toolchain ----
CONFIG_CCACHE=y

# ---- 修复（2026-10-16）：五件自写配方包必须显式启用（拷包≠选中，defconfig 只认 =y） ----
CONFIG_PACKAGE_mdk4=y
CONFIG_PACKAGE_cowpatty=y
CONFIG_PACKAGE_ettercap=y
CONFIG_PACKAGE_fluxion=y
CONFIG_PACKAGE_airgeddon=y
CONFIG_PACKAGE_evil-twin-mon=y            # mon 口生命周期管理 + tput shim（2026-10-18 实战新增）
CONFIG_PACKAGE_lighttpd-mod-cgi=y         # captive portal 走 php8-cgi 需要（24.10 版被依赖拉入，25.12 必须显式）
CONFIG_PACKAGE_lighttpd-mod-accesslog=y   # fluxion 生成的 lighttpd.conf 引用 mod_accesslog；access/alias/fastcgi/redirect/rewrite 都是 builtin 无需包（2026-10-19 实攻 dlopen 失败）
CONFIG_PACKAGE_kea-lfc=y                  # kea memfile 后端启动即调 /usr/sbin/kea-lfc，缺它 kea-dhcp4 起不来→手机拿不到 IP（2026-10-19 实攻）

# ---- 追加（2026-10-18）：T7 实机跑通 fluxion/airgeddon 的缺失件（逐项实证后回填） ----
# iptables：25.12 内核纯 nftables，但 fluxion 用 iptables 语法做门户重定向；
# iptables-nft 用户态经 netlink 翻译到 nft，附带拉入 kmod-ipt-core/kmod-nft-compat
CONFIG_PACKAGE_iptables-nft=y
# busybox 缺口（airgeddon/fluxion 直接调用，实测报 command not found）
CONFIG_PACKAGE_procps-ng=y                # 子包 DEPENDS:=procps-ng 不带 +，不选 meta 则下面三行被 defconfig 静默剪掉（2026-10-19 刷机后实锤）
CONFIG_PACKAGE_procps-ng-ps=y             # airgeddon check_inside_tmux 必须 `ps -p X -o comm=`
CONFIG_PACKAGE_procps-ng-pgrep=y          # fluxion 用 pgrep -P（busybox 版没有）
CONFIG_PACKAGE_procps-ng-pkill=y          # 清理孤儿攻击进程
CONFIG_PACKAGE_coreutils-whoami=y         # airgeddon 启动即调用
CONFIG_PACKAGE_coreutils-timeout=y        # airgeddon PMKID 流程包裹 hcxdumptool
CONFIG_PACKAGE_coreutils-shuf=y           # airgeddon 菜单随机化
CONFIG_PACKAGE_coreutils-realpath=y       # busybox 版缺 -f
CONFIG_PACKAGE_coreutils-stat=y           # busybox 本版未编 stat
CONFIG_PACKAGE_pciutils=y                 # airgeddon essential 工具（lspci）
CONFIG_PACKAGE_macchanger=y               # fluxion 依赖清单
CONFIG_PACKAGE_openssl-util=y             # fluxion 依赖清单（openssl 命令）
CONFIG_PACKAGE_unzip=y                    # fluxion 依赖清单
CONFIG_PACKAGE_psmisc=y                   # fluxion 依赖清单（fuser）
CONFIG_PACKAGE_terminfo=y                 # tput shim 需要 terminfo 数据库
CONFIG_PACKAGE_jq=y                       # airgeddon WPS/PMKID JSON 解析
CONFIG_PACKAGE_xxd=y                      # airgeddon WPS pin 处理
CONFIG_PACKAGE_bc=y                       # fluxion 依赖清单

# ---- 追加（2026-10-16）：网页终端 + screen ----
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y     # 隐藏 i18n 包，必须显式（DEPENDS 不带 +）
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_btop=y                    # 现代系统监视器（admin/btop）
