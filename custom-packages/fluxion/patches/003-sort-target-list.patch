t7: sort target lists ascending: weak/no-client APs first, strong/client
APs at the bottom (user preference). Unsupported power (-1) counts as
weakest (score -999). Pure-bash selection sort on a single score
(clients*10000 + power) because busybox sort supports only [-nru] (no
-k multi-key). Parallel candidate* arrays: one index permutation.

--- a/fluxion.sh
+++ b/fluxion.sh
@@ -1870,6 +1870,45 @@
     fi
   done
 
+  # Sort candidates by client count (asc), then power (asc): weak APs with
+  # no clients first, strong APs with clients at the bottom. Unsupported
+  # power (-1) counts as weakest (score -999). Pure-bash selection sort on
+  # a single score (clients*10000 + power): busybox sort has no -k support.
+  # All candidate* arrays are parallel: reorder by one index permutation.
+  if [ ${#candidatesMAC[@]} -gt 1 ]; then
+    local -a __sortByClientsPower=() __sortScore=()
+    local __i __j __best __tmp __pw
+    for __i in "${!candidatesMAC[@]}"; do
+      __pw=${candidatesPower[$__i]}
+      [ "$__pw" = "-1" ] && __pw=-999
+      __sortScore[$__i]=$(( candidatesClientsCount[$__i] * 10000 + __pw ))
+      __sortByClientsPower+=("$__i")
+    done
+    for __i in "${!__sortByClientsPower[@]}"; do
+      __best=$__i
+      for (( __j = __i + 1; __j < ${#__sortByClientsPower[@]}; __j++ )); do
+        if [ "${__sortScore[${__sortByClientsPower[$__j]}]}" -lt \
+             "${__sortScore[${__sortByClientsPower[$__best]}]}" ]; then
+          __best=$__j
+        fi
+      done
+      __tmp=${__sortByClientsPower[$__i]}
+      __sortByClientsPower[$__i]=${__sortByClientsPower[$__best]}
+      __sortByClientsPower[$__best]=$__tmp
+    done
+    local __arrName __oi
+    for __arrName in candidatesColor candidatesHandshake candidatesESSID \
+      candidatesQuality candidatesPower candidatesClientsCount \
+      candidatesChannel candidatesSecurity candidatesMAC candidatesVendor; do
+      local -a __sortOld=() __sortNew=()
+      eval "__sortOld=(\"\${$__arrName[@]}\")"
+      for __oi in "${__sortByClientsPower[@]}"; do
+        __sortNew+=("${__sortOld[$__oi]}")
+      done
+      eval "$__arrName=(\"\${__sortNew[@]}\")"
+    done
+  fi
+
   # Check if all networks were filtered out
   if [ ${#candidatesMAC[@]} -eq 0 ]; then
     local emptyMessage=""
