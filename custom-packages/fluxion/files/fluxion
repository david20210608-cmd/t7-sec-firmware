#!/bin/sh
# wrapper (not a symlink) so we can provision monitor interfaces around the
# run: fluxion's own interface handling targets USB dongles, and whatever mode
# it leaves behind must not survive the session (see custom-packages/evil-twin-mon)

# fluxion 进场会把选中接口整体改名（wlan0→fluxwl0，防抢占，lib/InterfaceUtils.sh
# 的 interface_reidentify）；Ctrl-C/杀 tmux 中断还原时残留 fluxwl*。本固件基线
# （radio disabled，只有 evil-twin-mon 的 mon<N>）没有这些口，直接删除即可：
# mon 口由 evil-twin-mon ensure 重建，netifd 的口（攻击期间拉起过 radio 时）
# 由 wifi reload 按 uci 配置重建——wrapper 不代管任何接口。
fluxion_ifrestore() {
	local n
	for n in $(ip -o link show 2>/dev/null | sed -n 's/^[0-9]*: \(fluxwl[^:@]*\):.*/\1/p'); do
		iw dev "$n" del 2>/dev/null
	done
}

/usr/bin/evil-twin-mon ensure
# fw4（nftables）input 基础链 policy=drop，fluxwl* 不属于任何 zone：手机的
# DNS 劫持与 DNAT 后的 80/443 流量全被静默丢弃（2026-10-22 实攻：能连 WiFi、
# 拿到 IP，但门户不可达，无任何弹窗）。会话期间放行。幂等插入、退出不清理
# ——fluxwl* 接口退场即删，规则平时匹配不到任何包，留着无害。
nft list chain inet fw4 input 2>/dev/null | grep -q fluxwl || \
	nft insert rule inet fw4 input iifname "fluxwl*" counter accept
# fluxion 生成的 lighttpd.conf 固定绑 0.0.0.0:80，与 uhttpd(LuCI) 冲突；
# 但不再进场就停（handshake snooper 单独跑时不碰 :80）：004 补丁在门户的
# lighttpd 真正启动前接管、stop_attack 里归还。这里只在 trap 兜底恢复一次
# （幂等；Ctrl-C/杀 tmux 强杀场景靠它兜住）。
trap '
	rc=$?
	/etc/init.d/uhttpd start
	fluxion_ifrestore
	wifi reload
	/usr/bin/evil-twin-mon ensure
	exit $rc
' EXIT HUP INT TERM
TERM="${TERM:-xterm}" /usr/share/fluxion/fluxion.sh "$@"
exit
