#!/bin/sh
# wrapper (not a symlink) so we can provision monitor interfaces around the
# run: fluxion's own interface handling targets USB dongles, and whatever mode
# it leaves behind must not survive the session (see custom-packages/evil-twin-mon)

# fluxion 进场会把选中接口整体改名（wlan0→fluxwl0，防抢占，lib/InterfaceUtils.sh
# 的 interface_reidentify）；正常退出会改回原名，但 Ctrl-C/杀 tmux 中断还原时
# 残留 fluxwl*（managed/DOWN，原名只存于 fluxion 内存）。这里进场快照接口名
# 集合，退场按差集 1:1 改回；对不上号（原名被重建占用）或改名失败则删除兜底。
FLUX_IF_PRE=$(ls /sys/class/net 2>/dev/null)

fluxion_ifrestore() {
	local post gone newflux g n
	post=$(ls /sys/class/net 2>/dev/null)
	gone=""
	for n in $FLUX_IF_PRE; do
		echo "$post" | grep -qx "$n" || gone="$gone $n"
	done
	newflux=""
	for n in $post; do
		case "$n" in
		fluxwl*|fluxet*) echo "$FLUX_IF_PRE" | grep -qx "$n" || newflux="$newflux $n" ;;
		esac
	done
	[ -z "${newflux# }" ] && return 0
	set -- $newflux
	for g in $gone; do
		n=$1; shift
		[ -n "$n" ] || break
		ip link set "$n" down 2>/dev/null
		iw dev "$n" set type managed 2>/dev/null
		# 仅当消失数与残留数一致（典型 1:1）才信任差集配对，否则宁删勿猜
		if [ "$(echo $gone | wc -w)" -eq "$(echo $newflux | wc -w)" ] \
			&& ip link show "$g" >/dev/null 2>&1; then
			ip link set "$n" name "$g" 2>/dev/null || ip link del "$n" 2>/dev/null
		else
			ip link del "$n" 2>/dev/null
		fi
	done
}

/usr/bin/evil-twin-mon ensure
# fluxion 生成的 lighttpd.conf 固定绑 0.0.0.0:80，与 uhttpd(LuCI) 冲突；
# 攻击会话期间让位，退出即恢复（2026-10-19 实攻踩坑固化）。
# 恢复动作全走 trap：fluxion 被 Ctrl-C/杀 tmux 强杀时同样执行。
/etc/init.d/uhttpd stop
trap '
	rc=$?
	/etc/init.d/uhttpd start
	/usr/bin/evil-twin-mon ensure
	fluxion_ifrestore
	exit $rc
' EXIT HUP INT TERM
TERM="${TERM:-xterm}" /usr/share/fluxion/fluxion.sh "$@"
exit
