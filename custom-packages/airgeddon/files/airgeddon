#!/bin/sh
# headless: router has no xterm, force tmux window handling
export AIRGEDDON_WINDOWS_HANDLING=tmux
# disable startup update check (nags/timeout; v12.02 evaluates the value as a command)
export AIRGEDDON_AUTO_UPDATE=false
# enable skip intro, slient checks
export AIRGEDDON_SKIP_INTRO=true
export AIRGEDDON_SILENT_CHECKS=true
# disable 6Ghz
export AIRGEDDON_6GHZ_ENABLED=false
# :80 归还：attack lighttpd 被杀后 socket 释放有延迟，盲目 start 会让 uhttpd
# 半绑定（v4 bind 失败静默，只剩 :::80，之后 start 永远空操作，2026-10-30
# 菜单正常退出实测复现）。等占用者退出，再仅在 0.0.0.0:80 没有 uhttpd 正常
# 监听时 restart——半绑定修复与停机补启动二合一，健康时不动 LuCI。
uhttpd_handback() {
	local i=0
	while [ "$i" -lt 15 ] && netstat -tlnp 2>/dev/null | grep '0\.0\.0\.0:80 ' | grep -qv uhttpd; do
		sleep 0.2
		i=$((i+1))
	done
	netstat -tlnp 2>/dev/null | grep -q '0\.0\.0\.0:80 .*uhttpd' || \
		/etc/init.d/uhttpd restart >/dev/null 2>&1
}

/usr/bin/evil-twin-mon ensure
# uhttpd(LuCI)/dnsmasq 不再进场就停（handshake/PMKID/WPS 不碰 :80/:53）：
# airgeddon 007 补丁在真正走到 evil twin 的 launch_dns_blackhole /
# launch_webserver 时才接管，restore_et_interface 在攻击结束即归还。
# trap 兜底：wrapper 被强杀时 tmux 窗口里的 attack lighttpd/dnsmasq 会残留。
# dnsmasq 的 attack 实例与系统实例进程同名、netstat -p 区分不了，只能按
# "是否杀到残留"决定是否等待+restart；uhttpd 一律走 handback（健康时零动作）。
trap '
	rc=$?
	killed=0
	pkill -f "lighttpd -D -f.*ag\\.lighttpd\\.conf" 2>/dev/null && killed=1
	pkill -f "dnsmasq -C.*ag\\.dnsmasq\\.conf" 2>/dev/null && killed=1
	if [ "$killed" = 1 ]; then
		i=0
		while [ "$i" -lt 15 ] && netstat -tlnup 2>/dev/null | grep -q ":53 "; do
			sleep 0.2
			i=$((i+1))
		done
		/etc/init.d/dnsmasq restart
	fi
	/etc/init.d/dnsmasq start
	uhttpd_handback
	# ET 联网共享的 iptables nat 残留兜底（airgeddon 的 MASQUERADE 带接口限定、
	# 危害小于 fluxion 的无限定版——那会 SNAT 掉回环流量让 zerotier-cli 401——
	# 但退出后同样无用）：fw4 用 inet fw4 表、dnsmasq 劫持用 inet dnsmasq 表，
	# 均不受影响；幂等。
	iptables -t nat -F PREROUTING 2>/dev/null
	iptables -t nat -F POSTROUTING 2>/dev/null
	/usr/bin/evil-twin-mon ensure
	exit $rc
' EXIT HUP INT TERM
bash /usr/share/airgeddon/airgeddon.sh "$@"
exit
