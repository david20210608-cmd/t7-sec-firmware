t7: stop LuCI/system dnsmasq only when an evil twin attack actually
starts, not at airgeddon launch. launch_webserver takes over :80,
launch_dns_blackhole takes over :53 (dnsmasq-full wildcard-bind conflict),
restore_et_interface hands both back when the attack tears down -
handshake/PMKID/WPS runs never touch them. Pairs with the wrapper change
(trap keeps a safety-net restart).

diff --git a/airgeddon.sh b/airgeddon.sh
index b8ffdc9..1de0b77 100755
--- a/airgeddon.sh
+++ b/airgeddon.sh
@@ -1775,6 +1775,29 @@ function restore_et_interface() {
 
 	debug_print
 
+	# t7: wrapper no longer stops LuCI/system dnsmasq up front - give them
+	# back as soon as the attack tears down (kill_et_windows above already
+	# SIGTERMed the attack instances). A blind start races their socket
+	# release: uhttpd half-binds (v4 bind fails silently, only :::80 left;
+	# every later start is a no-op) and dnsmasq dies on "address in use".
+	# dnsmasq: wait for :53 to clear, then restart (ET teardown always took
+	# it over). uhttpd: wait for a non-uhttpd holder on 0.0.0.0:80, restart
+	# iff uhttpd isn't properly listening (healthy = zero action).
+	local i=0
+	while [ $i -lt 15 ] && netstat -tlnup 2>/dev/null | grep -q ':53 '; do
+		sleep 0.2
+		i=$((i+1))
+	done
+	netstat -tlnup 2>/dev/null | grep -q ':53 ' || \
+		/etc/init.d/dnsmasq restart > /dev/null 2>&1
+	local j=0
+	while [ $j -lt 15 ] && netstat -tlnp 2>/dev/null | grep '0\.0\.0\.0:80 ' | grep -qv uhttpd; do
+		sleep 0.2
+		j=$((j+1))
+	done
+	netstat -tlnp 2>/dev/null | grep -q '0\.0\.0\.0:80 .*uhttpd' || \
+		/etc/init.d/uhttpd restart > /dev/null 2>&1
+
 	echo
 	language_strings "${language}" 299 "blue"

@@ -13327,6 +13333,10 @@ function launch_dns_blackhole() {
 
 	debug_print
 
+	# t7: system dnsmasq-full wildcard-binds :53, the attack instance
+	# would fail with "Address in use" - take over only now (see wrapper).
+	/etc/init.d/dnsmasq stop > /dev/null 2>&1
+
 	recalculate_windows_sizes
 
 	rm -rf "${tmpdir}${dnsmasq_file}" > /dev/null 2>&1
@@ -13761,6 +13771,10 @@ function launch_webserver() {
 
 	debug_print
 
+	# t7: portal needs :80, LuCI (uhttpd) holds it - take over only when
+	# the portal actually starts, handshake/PMKID/WPS runs never touch it.
+	/etc/init.d/uhttpd stop > /dev/null 2>&1
+
 	recalculate_windows_sizes
 	lighttpd_window_position=${g4_bottomright_window}
 	manage_output "+j -bg \"#000000\" -fg \"#FFFF00\" -geometry ${lighttpd_window_position} -T \"Webserver\"" "lighttpd -D -f \"${tmpdir}${webserver_file}\"" "Webserver"
@@ -1371,10 +1371,18 @@ function check_busy_ports() {
 function check_busy_ports() {
 
 	debug_print
 
 	IFS=' ' read -r -a tcp_ports <<< "${ports_needed["tcp"]}"
 	IFS=' ' read -r -a udp_ports <<< "${ports_needed["udp"]}"
 
+	# t7: uhttpd(LuCI) is only stopped when the portal web server actually
+	# launches (launch_webserver), which happens AFTER this preflight - stop
+	# it here first so the check doesn't fail on our own LuCI. If a foreign
+	# process still holds the port, bring uhttpd back before bailing out.
+	if [[ " ${tcp_ports[*]} " == *" ${www_port} "* ]]; then
+		/etc/init.d/uhttpd stop > /dev/null 2>&1
+	fi
+
 	if [[ -n "${tcp_ports[*]}" ]] && [[ "${#tcp_ports[@]}" -ge 1 ]]; then
 		port_type="tcp"
 		for tcp_port in "${tcp_ports[@]}"; do
@@ -1381,5 +1389,8 @@ function check_busy_ports() {
 			if ! check_tcp_udp_port "${tcp_port}" "${port_type}" "${interface}"; then
 				busy_port="${tcp_port}"
+				# t7: we may have stopped uhttpd for this preflight; bring it
+				# back when a genuinely foreign process still blocks the port.
+				[[ "${tcp_port}" = "${www_port}" ]] && /etc/init.d/uhttpd start > /dev/null 2>&1
 				find_process_name_by_port "${tcp_port}" "${port_type}"
 				echo
 				language_strings "${language}" 698 "red"
